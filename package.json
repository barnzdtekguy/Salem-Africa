{
  "name": "salem-africa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/tokens.mjs verify",
    "tokens:css": "node scripts/tokens.mjs css",
    "install:ci": "node scripts/install-ci.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lenis": "^1.3.26",
    "lucide-react": "^0.446.0",
    "next": "^15.5.28",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.7"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
